# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=
CLICKHOUSE_DATABASE=

# Google auth -- pick ONE path.
# (a) AI Studio API key: set GOOGLE_API_KEY, leave GOOGLE_GENAI_USE_VERTEXAI empty.
# (b) Vertex AI: set GOOGLE_GENAI_USE_VERTEXAI=true + GOOGLE_CLOUD_PROJECT/LOCATION.
GOOGLE_API_KEY=

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=
GCS_BUCKET=
# true serves assets from a public bucket; false needs a service account that
# can sign, which a local user credential cannot do.
GCS_PUBLIC_ASSETS=
GCS_SIGNED_URL_TTL_SEC=21600

# Models (verify in Model Garden at implementation time)
MODEL_REASONING=
MODEL_FAST=
# Imagen publisher models 404 on an AI Studio project; these two run on the
# same Vertex surface the agents already use. See app/media.py.
MODEL_IMAGE=gemini-2.5-flash-image
MODEL_TTS=gemini-2.5-flash-preview-tts
MODEL_TTS_VOICE=Charon
