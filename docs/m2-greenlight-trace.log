       countIf(has_interest_signal) AS n_interest,
       quantileIf(0.5)(interest_cohort_pct, has_interest_signal) AS interest_median
FROM films
WHERE roi IS NOT NULL
  AND (has(motif_tags, 'hidden_conspiracy') OR has(motif_tags, 'memory_and_truth') OR has(motif_tags, 'identity_concealed') OR has(motif_tags, 'wrongful_accusation'))
  AND (has(character_archetypes, 'outcast') OR has(character_archetypes, 'fallen_idol') OR has(character_archetypes, 'witness') OR has(character_archetypes, 'shadow_antagonist'))
  AND (budget_usd >= 20000000 AND budget_usd < 80000000)
